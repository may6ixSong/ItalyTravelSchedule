rules_version = '2';

// 이탈리아 여행 앱 보안 규칙
// - 앱은 Firebase 익명 로그인을 씁니다.
// - 최초 접속 때 입장 코드(1234)를 맞힌 기기만 users/{uid} 문서를 만들 수 있고,
//   users 문서가 있는 기기만 나머지 데이터를 읽고 쓸 수 있습니다.
// - 코드를 바꾸려면 아래 '1234'와 src/config.js의 JOIN_CODE를 같이 바꾸세요.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function member() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if member();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.joinCode == '1234';
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /{col}/{id} {
      allow read, write: if member() && col in ['expenses', 'records', 'photos', 'checklist', 'settings'];
    }
  }
}
